# API-Football key (api-sports.io). Leave unset to run in demo mode.
# Current-season data requires a paid plan; free tier serves 2021-2023 only.
API_FOOTBALL_KEY=

# Season start year, e.g. 2026 for the 2026-27 European season. Auto-computed if unset.
SEASON=

# Server port (default 8787)
PORT=

# Master switch for ALL unlicensed data sources (see server/src/unlicensed.js).
# The per-source flags below do nothing unless this is 1 as well.
# MUST be 0 (or unset) in any public release.
ENABLE_UNLICENSED_SOURCES=0

# Automatic match-level streaming lookup (see server/adapters/streaming/liveSoccerTv.js)
ENABLE_STREAMING_AUTO=0
