{
  "name": "americans-abroad",
  "version": "1.0.0",
  "private": true,
  "description": "Tracks American soccer players at clubs outside the United States",
  "scripts": {
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "discover": "node server/scripts/discover.js",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  }
}